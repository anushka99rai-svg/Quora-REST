<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
</head>
<body>
    <h1 class="Heading">Quora</h1>
    <% for (post of posts){ %>
    <div class="post">
        <h3> @<%=post.username %></h3>
        <h4><%=post.content %></h4>
        <a href="http://localhost:8080/posts/<%=post.id %>">See Post</a>
        <br>
        <a href="http://localhost:8080/posts/<%=post.id %>/edit">Edit Post</a>
        <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
        <button type="submit" class="delete">Delete Post</button>
        </form>
    </div>
    <% } %>
    <br>
    <a href="http://localhost:8080/posts/new">Create new post</a>
</body>
</html>


